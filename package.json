{
  "name": "dsh-plugin-studio",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "description": "Plugin Studio for DeepSeek Harness — one workspace that manages both installed plugins and skills: three-level auto-classification, batch removal with restart notice, plain-language AI analysis, last-used tracking, and one-click packing. 插件工坊：同时管理插件与技能，三级自动分类、批量删除、AI 大白话分析、最后使用时间、一键打包。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "modpack",
    "skills",
    "classifier"
  ],
  "license": "MIT",
  "author": "dsh-plugin-studio contributors",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/UPLOAD-GUIDE.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node scripts/all.mjs --offline",
    "test:live": "node scripts/all.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:analyse": "node scripts/analyse.mjs",
    "test:routes": "node scripts/routes.mjs",
    "test:actions": "node scripts/actions.mjs",
    "test:ai": "node scripts/ai.mjs",
    "test:style": "node scripts/style.mjs",
    "test:compat": "node scripts/compat.mjs",
    "render": "node scripts/render.mjs --offline",
    "measure": "node scripts/measure.mjs",
    "shots": "node scripts/shoot.mjs",
    "fixtures": "node scripts/_make-profile-fixture.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
